# Ignore Database and static warehouses
# ~72 GB of car databases and a 19 GB RAG index: never tracked.
/KG_backend/Database_warehouse/*
# ... except the evaluation gold sets (676 KB), which are the ground truth every
# retrieval metric in the dossier is measured against. Git needs the exclusion
# restated at each level: a negation cannot rescue a file whose parent directory
# is itself excluded.
!/KG_backend/Database_warehouse/_rag/
/KG_backend/Database_warehouse/_rag/*
!/KG_backend/Database_warehouse/_rag/eval/
/KG_backend/Database_warehouse/_rag/eval/*
!/KG_backend/Database_warehouse/_rag/eval/gold/
/KG_backend/static_warehouse/

# Ignore Claude metadata and VS Code workspace settings
/.claude
/.vscode

# Ignore compiled Python files
*.pyc

# Markdown: only stray notes at the repository root, which is where scratch
# files collect. A blanket `*.md` lived here until 2026-10-29 and silently
# ignored every new documentation file — docs/00-srs.md, the ADRs and the
# audit-evidence reports are tracked only because someone reached for
# `git add -f`. That is the exact opposite of the protocol in docs/README.md
# and of ADR-0006 (docs as code): the next doc nobody thought to force-add
# would simply never have been committed. 61 .md files are tracked and none
# of them is at the root, so narrowing this rule changes nothing that exists.
/*.md
!/README.md
!/SECURITY.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/CHANGELOG.md
!/AGENTS.md
!/CLAUDE.md
.DS_Store
/.venv
/Cars_database
/KG_backend/.venv

# Env files and backups (never commit secrets/binaries)
.env.prod
.env.prod.bak
# any env backup variant (.bak-hfoffline, .bak.<ts>, .pre-turnstile ...)
.env.prod*
*/.env.prod*
*.bak
*.bak_*
KG_backend/staticfiles/

# Never commit the live application database (credentials, tokens, PII)
/KG_backend/db.sqlite3
/KG_backend/db.sqlite3.*
/KG_backend/db.sqlite3-*

# Written by parser_gui.py on exit to remember the last-used folders,
# so it is per-machine. Tracking it meant each commit overwrote everyone
# else's paths. See parser_gui_config.example.json.
/parser_gui_config.json
