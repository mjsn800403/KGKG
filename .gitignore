.env
*.env
!.env.example

# Local database files (data lives outside git; reseed via api/fixtures/cars.json)
*.sqlite3
*.sqlite3-journal
*.sqbpro
/KG_backend/db.sqlite3

# Django collectstatic output
/KG_backend/staticfiles/
