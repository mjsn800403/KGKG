#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Promote a release to production. The only intended way to do it.
#
#   kgkg-promote <sha|ref>     promote that commit
#   kgkg-promote               promote whatever CI last staged successfully
#   kgkg-promote --status      what is live, what was staged, what would change
#
# Why a wrapper around ops/deploy/deploy.sh, which already does the work:
#
#   * It refuses a commit GitHub's CI did not pass. The server's own gate says
#     whether a release runs, not whether the suite passed — it runs no
#     coverage ratchet, no eslint ratchet, no bandit, no dependency audit and
#     no image scan. On 2026-10-29 that gap let 536ac91 go live with CI red on
#     the coverage ratchet (55 % against a 56 % floor). ops/deploy/ci_evidence.sh
#     asks GitHub about the exact commit; anything but four green required jobs,
#     GitHub being unreachable included, needs the longer phrase.
#   * It refuses a commit that has not passed staging. CI stages every push to
#     `work` against a sanitized copy of the production database; promoting
#     something that never went through that is now a deliberate act with a
#     different, longer confirmation, not a typo away from the normal one.
#   * It refuses, the same way, a commit without a passing full browser E2E
#     run (qa/run_e2e.sh writes $REL/e2e/<sha>.env). Staging smoke proves the
#     release starts and answers; E2E proves the journeys and the access rules
#     still hold. Every promotion without either is logged to
#     $REL/promote-overrides.log.
#   * It shows what will change before it changes it: the live release, the
#     target, the commits and files between them, whether migrations are
#     involved, and how old the staging evidence is.
#   * It requires the word `promote` to be typed. There is no --yes flag, and
#     no timer, cron or CI path that reaches this script: production does not
#     move without a person.
#
# deploy.sh then re-runs the gate and staging on the exact commit before it
# touches production. That repetition is deliberate — CI's result is evidence,
# not permission.
# ---------------------------------------------------------------------------
set -Eeuo pipefail

PROD=${KG_PROD_DIR:-/opt/KGKG}
REL=${KG_REL_DIR:-/opt/KGKG_release}
DEPLOY=${KG_DEPLOY_SH:-$PROD/ops/deploy/deploy.sh}
CI_EVIDENCE=${KG_CI_EVIDENCE_SH:-$PROD/ops/deploy/ci_evidence.sh}
STAGING_MAX_AGE_H=${KG_PROMOTE_STAGING_MAX_AGE_H:-72}
E2E_MAX_AGE_H=${KG_PROMOTE_E2E_MAX_AGE_H:-72}

die() { echo "kgkg-promote: $*" >&2; exit 1; }

STAGED_SHA=; STAGED_AT=; SMOKE=; GATE=
# shellcheck source=/dev/null
[[ -f $REL/staging.env ]] && . "$REL/staging.env"

CURRENT=; PREVIOUS=
# shellcheck source=/dev/null
[[ -f $REL/state.env ]] && . "$REL/state.env"

human_age() {  # epoch -> "3h 12m ago"
  local then=$1 now delta
  now=$(date -u +%s); delta=$(( now - then ))
  (( delta < 0 )) && { echo "in the future"; return; }
  printf '%dh %dm ago\n' $(( delta / 3600 )) $(( (delta % 3600) / 60 ))
}

to_epoch() {  # ISO time -> epoch, 0 when missing or unparsable
  [[ -n ${1:-} ]] || { echo 0; return; }
  date -u -d "$1" +%s 2>/dev/null || echo 0
}
staged_epoch() { to_epoch "$STAGED_AT"; }

show_status() {
  echo "live release    : ${CURRENT:0:9}${CURRENT:+ (previous ${PREVIOUS:0:9})}"
  if [[ -n $STAGED_SHA ]]; then
    local e; e=$(staged_epoch)
    echo "last staged     : ${STAGED_SHA:0:9}  gate=${GATE:-?} smoke=${SMOKE:-?}  $( (( e )) && human_age "$e" || echo "$STAGED_AT")"
  else
    echo "last staged     : nothing recorded"
  fi
}

if [[ ${1:-} == --status ]]; then
  show_status
  exit 0
fi

REF=${1:-}
if [[ -z $REF ]]; then
  [[ -n $STAGED_SHA ]] || die "no ref given and no staging record to fall back on. Run: kgkg-promote <sha>"
  REF=$STAGED_SHA
  echo "no ref given; using the last successfully staged commit"
fi

git -C "$PROD" fetch -q origin work || die "could not fetch origin/work"
SHA=$(git -C "$PROD" rev-parse --verify "$REF^{commit}" 2>/dev/null) \
  || die "unknown ref: $REF"
SHORT=${SHA:0:9}

[[ $SHA != "$CURRENT" ]] || die "$SHORT is already live (use ops/deploy/deploy.sh --force to rebuild it)"

git -C "$PROD" merge-base --is-ancestor "$SHA" origin/work 2>/dev/null \
  || die "$SHORT is not on origin/work; push it first"

# ---- staging evidence ------------------------------------------------------
UNSTAGED_REASON=
if [[ -z $STAGED_SHA ]]; then
  UNSTAGED_REASON="nothing has been staged on this host"
elif [[ $STAGED_SHA != "$SHA" ]]; then
  UNSTAGED_REASON="the last staged commit is ${STAGED_SHA:0:9}, not $SHORT"
elif [[ ${SMOKE:-} != pass ]]; then
  UNSTAGED_REASON="the staging run for $SHORT did not pass smoke (smoke=${SMOKE:-?})"
else
  AGE_S=$(( $(date -u +%s) - $(staged_epoch) ))
  if (( AGE_S > STAGING_MAX_AGE_H * 3600 )); then
    UNSTAGED_REASON="the staging evidence for $SHORT is older than ${STAGING_MAX_AGE_H}h"
  fi
fi

# ---- E2E evidence ----------------------------------------------------------
E2E_SHA=; E2E_AT=; E2E_SCOPE=; E2E_RESULT=; E2E_PASSED=; E2E_FAILED=
NOE2E_REASON=
E2E_FILE=$REL/e2e/$SHA.env
if [[ ! -f $E2E_FILE ]]; then
  NOE2E_REASON="no browser E2E run is recorded for $SHORT"
else
  # shellcheck source=/dev/null
  . "$E2E_FILE"
  if [[ $E2E_SHA != "$SHA" ]]; then
    NOE2E_REASON="the E2E record for $SHORT names another commit (${E2E_SHA:0:9})"
  elif [[ $E2E_SCOPE != full ]]; then
    NOE2E_REASON="the only E2E run for $SHORT was filtered (scope=${E2E_SCOPE:-?}), not the full suite"
  elif [[ $E2E_RESULT != pass ]]; then
    NOE2E_REASON="the E2E run for $SHORT failed (${E2E_FAILED:-?} failed, ${E2E_PASSED:-?} passed)"
  elif (( $(date -u +%s) - $(to_epoch "$E2E_AT") > E2E_MAX_AGE_H * 3600 )); then
    NOE2E_REASON="the E2E evidence for $SHORT is older than ${E2E_MAX_AGE_H}h"
  fi
fi

# ---- CI evidence -----------------------------------------------------------
# Fails closed: "unknown" is not "pass". A host that cannot reach GitHub can
# still promote, but only through the phrase, and the reason is logged.
NOCI_REASON=
CI_VERDICT=$(KG_PROD_DIR="$PROD" bash "$CI_EVIDENCE" verdict "$SHA" 2>/dev/null || echo 'unknown ci_evidence.sh could not be run')
case $CI_VERDICT in
  pass) ;;
  fail*)    NOCI_REASON="GitHub CI did not pass $SHORT (${CI_VERDICT#fail })" ;;
  unknown*) NOCI_REASON="GitHub CI cannot be confirmed for $SHORT (${CI_VERDICT#unknown })" ;;
  *)        NOCI_REASON="ci_evidence.sh answered something unexpected: $CI_VERDICT" ;;
esac

# ---- what will change ------------------------------------------------------
echo
echo "========================================================================"
show_status
echo "promoting       : $SHORT"
echo
echo "commits to apply:"
git -C "$PROD" log --oneline --no-decorate "${CURRENT:-HEAD}..$SHA" | sed 's/^/  /' | head -20
N=$(git -C "$PROD" rev-list --count "${CURRENT:-HEAD}..$SHA" 2>/dev/null || echo 0)
(( N > 20 )) && echo "  ... and $(( N - 20 )) more"
echo
CHANGED=$(git -C "$PROD" diff --name-only "${CURRENT:-HEAD}" "$SHA" || true)
echo "files changed   : $(wc -l <<<"$CHANGED") "
MIGRATIONS=$(grep -c '/migrations/' <<<"$CHANGED" || true)
echo "migrations      : ${MIGRATIONS:-0} file(s)$( (( ${MIGRATIONS:-0} )) && echo '  <-- forward-only; the pre-deploy DB backup is the way back')"
grep -qE '^ops/docker/backend-requirements.lock$' <<<"$CHANGED" \
  && echo "dependencies    : the backend lock changed; the host venv will be updated too"
grep -qE '^ops/' <<<"$CHANGED" && echo "ops tooling     : ops/ changed; re-read it before the next deploy"
echo "========================================================================"
echo

# ---- confirmation ----------------------------------------------------------
MISSING=
# Order is fixed — ci, staging, e2e — so the phrase a person is asked to type
# is the same every time for the same combination of missing evidence.
[[ -n $NOCI_REASON ]] && MISSING=ci
[[ -n $UNSTAGED_REASON ]] && MISSING=${MISSING:+$MISSING and }staging
[[ -n $NOE2E_REASON ]] && MISSING=${MISSING:+$MISSING and }e2e
if [[ -n $MISSING ]]; then
  {
    echo "REFUSING THE NORMAL PATH:"
    [[ -n $NOCI_REASON ]] && echo "  - $NOCI_REASON"
    [[ -n $UNSTAGED_REASON ]] && echo "  - $UNSTAGED_REASON"
    [[ -n $NOE2E_REASON ]] && echo "  - $NOE2E_REASON"
    cat <<WARN

CI is how the suite, the ratchets and the scanners are shown to have passed;
staging is how a release is shown to work against real data shapes; the E2E
suite is how the sign-in, access and media rules are shown to still hold.
Promoting without them is a judgement call that should feel different from
the usual one, and it is logged.

Get the evidence first (recommended):
WARN
    [[ -n $NOCI_REASON ]] && echo "    push $SHORT and wait for ci to go green: gh run list --commit $SHA"
    [[ -n $UNSTAGED_REASON ]] && echo "    ops/deploy/deploy.sh --staging $SHA"
    [[ -n $NOE2E_REASON ]] && echo "    qa/stack.sh up $SHA && qa/run_e2e.sh"
    echo
    echo "Or, to promote anyway, type the full phrase at the prompt."
  } >&2
  printf 'type "promote %s without %s" to continue: ' "$SHORT" "$MISSING"
  read -r reply
  [[ $reply == "promote $SHORT without $MISSING" ]] || die "not confirmed; nothing was done"
  printf '%s promote %s without %s by %s: %s%s%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$SHA" "$MISSING" \
    "${SUDO_USER:-${USER:-?}}" "${NOCI_REASON:+$NOCI_REASON; }" \
    "${UNSTAGED_REASON:+$UNSTAGED_REASON; }" "$NOE2E_REASON" \
    >> "$REL/promote-overrides.log"
else
  echo "CI evidence     : $SHORT passed every required job on GitHub"
  echo "staging evidence: $SHORT passed gate=${GATE:-?} and smoke=$SMOKE $(human_age "$(staged_epoch)")"
  echo "E2E evidence    : $SHORT passed ${E2E_PASSED} browser tests $(human_age "$(to_epoch "$E2E_AT")")"
  printf 'type "promote" to continue: '
  read -r reply
  [[ $reply == promote ]] || die "not confirmed; nothing was done"
fi

echo
exec bash "$DEPLOY" "$SHA"
