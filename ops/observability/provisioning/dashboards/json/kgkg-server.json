{
 "uid": "kgkg-server",
 "title": "KGKG \u2014 Server & containers",
 "tags": [
  "kgkg"
 ],
 "timezone": "Asia/Tehran",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "CPU used",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "100*(1-avg(rate(node_cpu_seconds_total{mode=\"idle\",instance=\"kgkg-vps\"}[5m])))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Memory used",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "100*(1-node_memory_MemAvailable_bytes{instance=\"kgkg-vps\"}/node_memory_MemTotal_bytes{instance=\"kgkg-vps\"})",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Disk / used",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "100*(1-node_filesystem_avail_bytes{mountpoint=\"/\",instance=\"kgkg-vps\"}/node_filesystem_size_bytes{mountpoint=\"/\",instance=\"kgkg-vps\"})",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Load (1m)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "node_load1{instance=\"kgkg-vps\"}",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Uptime",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "time()-node_boot_time_seconds{instance=\"kgkg-vps\"}",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Containers",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "count(container_last_seen{name!=\"\"})",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "CPU by mode",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 40
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "100*sum by (mode)(rate(node_cpu_seconds_total{mode!=\"idle\",instance=\"kgkg-vps\"}[5m]))/scalar(count(node_cpu_seconds_total{mode=\"idle\",instance=\"kgkg-vps\"}))",
     "legendFormat": "{{mode}}",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "node_memory_MemTotal_bytes{instance=\"kgkg-vps\"}-node_memory_MemAvailable_bytes{instance=\"kgkg-vps\"}",
     "legendFormat": "used",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "node_memory_MemTotal_bytes{instance=\"kgkg-vps\"}",
     "legendFormat": "total",
     "refId": "B"
    }
   ],
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Disk I/O",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(node_disk_read_bytes_total{instance=\"kgkg-vps\"}[5m]))",
     "legendFormat": "read",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(node_disk_written_bytes_total{instance=\"kgkg-vps\"}[5m]))",
     "legendFormat": "write",
     "refId": "B"
    }
   ],
   "options": {}
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Network",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\",instance=\"kgkg-vps\"}[5m]))",
     "legendFormat": "in",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\",instance=\"kgkg-vps\"}[5m]))",
     "legendFormat": "out",
     "refId": "B"
    }
   ],
   "options": {}
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Docker container CPU (cores)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (name)(rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Docker container memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (name)(container_memory_working_set_bytes{name!=\"\"})",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "systemd services CPU (cores) \u2014 kgkg-backend, frontend, nginx\u2026",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "topk(8, sum by (id)(rate(container_cpu_usage_seconds_total{id=~\"/system.slice/.+[.]service\"}[5m])))",
     "legendFormat": "{{id}}",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "systemd services memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "topk(8, sum by (id)(container_memory_working_set_bytes{id=~\"/system.slice/.+[.]service\"}))",
     "legendFormat": "{{id}}",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 20,
   "type": "stat",
   "title": "Up now (1 = up)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 36,
    "w": 12,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "probe_success",
     "legendFormat": "{{target}}",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 21,
   "type": "stat",
   "title": "Uptime 7d",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 36,
    "w": 12,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "avg_over_time(probe_success[7d])*100",
     "legendFormat": "{{target}}",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 22,
   "type": "timeseries",
   "title": "Response time (probe)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 41,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "probe_duration_seconds",
     "legendFormat": "{{target}}",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 23,
   "type": "timeseries",
   "title": "TLS cert days left",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 41,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "d"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "(probe_ssl_earliest_cert_expiry-time())/86400",
     "legendFormat": "{{target}}",
     "refId": "A"
    }
   ],
   "options": {}
  },
  {
   "id": 24,
   "type": "timeseries",
   "title": "nginx 5xx and 4xx per minute",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 49,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({job=\"nginx\",stream=\"access\",status_class=\"5\"}[1m]))",
     "legendFormat": "5xx",
     "refId": "A",
     "queryType": "range"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({job=\"nginx\",stream=\"access\",status_class=\"4\"}[1m]))",
     "legendFormat": "4xx",
     "refId": "B",
     "queryType": "range"
    }
   ],
   "options": {}
  },
  {
   "id": 25,
   "type": "timeseries",
   "title": "5xx share of requests",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 49,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({job=\"nginx\",stream=\"access\",status_class=\"5\"}[5m])) / sum(count_over_time({job=\"nginx\",stream=\"access\"}[5m])) * 100",
     "legendFormat": "5xx %",
     "refId": "A",
     "queryType": "range"
    }
   ],
   "options": {}
  },
  {
   "id": 26,
   "type": "timeseries",
   "title": "Backend errors per minute",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 57,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (logger)(count_over_time({job=\"kgkg-backend\",level=~\"ERROR|CRITICAL\"}[1m]))",
     "legendFormat": "{{logger}}",
     "refId": "A",
     "queryType": "range"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (unit)(count_over_time({job=\"systemd\",unit=~\"kgkg-.*\",level=~\"err|crit|alert|emerg\"}[1m]))",
     "legendFormat": "{{unit}}",
     "refId": "B",
     "queryType": "range"
    }
   ],
   "options": {}
  },
  {
   "id": 27,
   "type": "logs",
   "title": "Latest nginx & backend errors",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 57,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"nginx\",stream=\"error\"}",
     "legendFormat": "",
     "refId": "A",
     "queryType": "range"
    },
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"kgkg-backend\",level=~\"ERROR|CRITICAL\"}",
     "legendFormat": "",
     "refId": "B",
     "queryType": "range"
    }
   ],
   "options": {}
  }
 ]
}