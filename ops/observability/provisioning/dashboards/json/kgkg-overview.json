{
 "uid": "kgkg-overview",
 "title": "KGKG \u2014 Logs overview",
 "tags": [
  "kgkg"
 ],
 "timezone": "Asia/Tehran",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Backend log events by level",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (level) (count_over_time({job=\"kgkg-backend\", level=~\"WARNING|ERROR|CRITICAL\"}[$__auto]))",
     "legendFormat": "{{level}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "HTTP responses by status class (nginx)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum by (status_class) (count_over_time({job=\"nginx\", stream=\"access\"}[$__auto]))",
     "legendFormat": "{{status_class}}xx"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "5xx responses",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({job=\"nginx\", stream=\"access\", status_class=\"5\"}[$__auto]))",
     "legendFormat": "5xx"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "SMS failures (notify + OTP)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 60,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({job=\"kgkg-backend\"} |~ \"notify .* failed|SendSMS failed|alert SMS .* failed\" [$__auto]))",
     "legendFormat": "failed SMS"
    }
   ]
  },
  {
   "id": 5,
   "type": "logs",
   "title": "Backend errors & warnings",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"kgkg-backend\", level=~\"WARNING|ERROR|CRITICAL\"}"
    }
   ]
  },
  {
   "id": 6,
   "type": "logs",
   "title": "Service journal errors (backend, frontend, pipeline, nginx)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 24,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"systemd\", level=~\"err|crit|alert|emerg|warning\"}"
    }
   ]
  },
  {
   "id": 7,
   "type": "logs",
   "title": "nginx error log",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 24,
    "h": 9
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"nginx\", stream=\"error\"}"
    }
   ]
  }
 ]
}