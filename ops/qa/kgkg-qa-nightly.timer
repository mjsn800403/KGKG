# 01:30 UTC = 05:00 Tehran, the quietest hour in the nginx logs. Persistent:
# a run missed while the host was down happens at the next boot.
[Unit]
Description=Run the KGKG nightly QA suite

[Timer]
OnCalendar=*-*-* 01:30:00 UTC
RandomizedDelaySec=10min
Persistent=true
Unit=kgkg-qa-nightly.service

[Install]
WantedBy=timers.target
