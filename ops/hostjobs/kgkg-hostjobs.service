[Unit]
Description=KGKG host-job bridge for the backend container (ops/hostjobs)
After=network.target

[Service]
Environment=KG_HOSTJOBS_DIR=/run/kgkg-hostjobs
ExecStart=/usr/bin/python3 /opt/KGKG/ops/hostjobs/hostjobs_daemon.py
# Chrome/Xvfb/x11vnc started for the TIS login must outlive a daemon restart.
KillMode=process
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
