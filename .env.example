# Copy to .env and fill in real values. .env is gitignored; this file is committed.
# Compose reads .env; for non-Docker local dev, settings.py also reads ./.env.

# ===== Django backend =====
# REQUIRED in production. Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=dev-insecure-change-me

# True for local development ONLY. MUST be False in production.
DJANGO_DEBUG=True

# Comma-separated hostnames allowed to serve the app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed by CORS (enforced when DEBUG is False).
DJANGO_CORS_ORIGINS=http://localhost:3000

# Set True only when served over HTTPS — enables HSTS, secure cookies, SSL redirect.
DJANGO_SECURE_SSL=False

# ===== Database =====
# Leave unset for local SQLite (settings.py default). For Postgres:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# (docker compose injects a Postgres URL automatically — no need to set it here.)
# DATABASE_URL=

# Credentials for the docker compose 'db' (Postgres) service:
POSTGRES_USER=kg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kg

# ===== Frontend (build-time; inlined into the client bundle) =====
NEXT_PUBLIC_API_BASE=http://localhost:8000
